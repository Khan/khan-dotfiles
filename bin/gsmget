#!/bin/sh

SCRIPT=$(basename $0)

usage() {
    cat << EOF2
usage: $SCRIPT [--internal] secretname <version>
  secretname is the name of the secret in Google Secret Manager. For a list of
  all the secrets, you can visit
  https://console.cloud.google.com/security/secret-manager?project=khan-academy
  (or ?project=khan-internal-services when using --internal)

  version is optional. If not specified then you get the latest version

  --internal  fetch the secret from the khan-internal-services project
              instead of khan-academy

  $SCRIPT Test_secret
  $SCRIPT Test_secret 1
  $SCRIPT Test_secret latest
  $SCRIPT --internal Test_secret
EOF2
}

PROJECT="khan-academy"

while [ $# -gt 0 ]
do
  case "$1" in
    --internal)
      PROJECT="khan-internal-services"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1"
      echo
      usage
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

SECRET=$1
VERSION=$2

if [ -z "$SECRET" ]
then
  echo "Must provide the name of a GSM secret as the first argument"
  echo
  usage
  exit 1
fi

if [ -z "$VERSION" ]
then
  VERSION="latest"
fi

# Command for getting secrets from google secret manager
exec gcloud --project "$PROJECT" secrets versions access "$VERSION" --secret "$SECRET"
